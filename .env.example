# OpenKG configuration. Copy to .env. Never commit real keys.
# With nothing set, the stack starts in demo mode with synthetic graphs and simulated runs.

# --- Live web research (both required for live runs) ---------------------------------------
TAVILY_API_KEY=
# Configure at least one model provider. OpenAI-only or Anthropic-only setups work.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: Valar (OpenAI-compatible). Leaving it empty never blocks startup.
VALAR_API_KEY=
VALAR_BASE_URL=https://api.valarhq.ai/v1
VALAR_API_MODE=responses        # responses | chat

# Which provider to use when several are configured: openai | anthropic | valar (default: first configured)
MODEL_PROVIDER=
# Explicit model ID for the primary provider (default: a documented ID per provider/role).
MODEL_NAME=
# Opt-in fallbacks for availability errors only (429/5xx/timeouts), e.g. "anthropic,openai:gpt-5-mini".
MODEL_FALLBACKS=
# Optional per-role overrides, "provider:model".
MODEL_ROLE_PLANNER=
MODEL_ROLE_RESEARCHER=
MODEL_ROLE_EXTRACTOR=
MODEL_ROLE_VERIFIER=
# Used only to ESTIMATE model spend; set to your provider's published per-million-token rates.
MODEL_INPUT_USD_PER_MTOK=3.0
MODEL_OUTPUT_USD_PER_MTOK=15.0

# --- Budgets (enforced server-side) ----------------------------------------------------------
DEFAULT_RUN_BUDGET_USD=1.0
DEFAULT_MAX_TAVILY_CALLS=40
DEFAULT_MAX_MODEL_CALLS=150
DEFAULT_RUN_DEADLINE_MINUTES=30
MAX_RUN_BUDGET_USD=25.0

# --- Deployment --------------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
DEMO_MODE=true                   # must be false when ENVIRONMENT=production
ALLOW_REGISTRATION=true
COOKIE_SECURE=false              # true behind HTTPS
POSTGRES_PASSWORD=openkg-local-only
WEB_PORT=3100
API_PORT=8100

# --- Local development without Docker (see README) ---------------------------------------------
# The default is a SQLite file at apps/api/.data/openkg.db. Point at PostgreSQL for anything shared:
# DATABASE_URL=postgresql://user:pass@localhost:5432/openkg
# EXECUTION_MODE=embedded        # embedded | celery
# REDIS_URL=redis://localhost:6379/0
